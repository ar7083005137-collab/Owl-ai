rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'shivambuildwith@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation functions
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 120 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('role' in data) || data.role in ['user', 'admin']) &&
             (!('aiRequestsCount' in data) || data.aiRequestsCount is int || data.aiRequestsCount is number) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidChatSession(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 500)) &&
             (!('messageCount' in data) || data.messageCount is int || data.messageCount is number) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidChatMessage(data) {
      return data.chatId is string && data.chatId.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 50000 &&
             (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidMathSolution(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.query is string && data.query.size() > 0 && data.query.size() <= 5000 &&
             (!('hasImage' in data) || data.hasImage is bool) &&
             data.steps is list && data.steps.size() <= 50 &&
             data.finalAnswer is string && data.finalAnswer.size() <= 5000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidAiCreation(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.type in ['image', 'video'] &&
             data.prompt is string && data.prompt.size() > 0 && data.prompt.size() <= 2000 &&
             data.mediaUrl is string && data.mediaUrl.size() > 0 && data.mediaUrl.size() <= 2000 &&
             (!('aspectRatio' in data) || (data.aspectRatio is string && data.aspectRatio.size() <= 20)) &&
             (!('provider' in data) || (data.provider is string && data.provider.size() <= 100)) &&
             (!('model' in data) || (data.model is string && data.model.size() <= 100)) &&
             data.status in ['completed', 'pending', 'failed'] &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidAppConfig(data) {
      return (data.version is int || data.version is number) &&
             data.maintenanceMode is bool &&
             (!('activeChatProvider' in data) || (data.activeChatProvider is string && data.activeChatProvider.size() <= 50)) &&
             (!('chatModel' in data) || (data.chatModel is string && data.chatModel.size() <= 100)) &&
             (!('activeImageProvider' in data) || (data.activeImageProvider is string && data.activeImageProvider.size() <= 50)) &&
             (!('imageModel' in data) || (data.imageModel is string && data.imageModel.size() <= 100)) &&
             (!('activeVideoProvider' in data) || (data.activeVideoProvider is string && data.activeVideoProvider.size() <= 50)) &&
             (!('videoModel' in data) || (data.videoModel is string && data.videoModel.size() <= 100)) &&
             (!('chatEnabled' in data) || data.chatEnabled is bool) &&
             (!('mathEnabled' in data) || data.mathEnabled is bool) &&
             (!('photoMathEnabled' in data) || data.photoMathEnabled is bool) &&
             (!('imageGenEnabled' in data) || data.imageGenEnabled is bool) &&
             (!('videoGenEnabled' in data) || data.videoGenEnabled is bool) &&
             (!('dailyRequestLimit' in data) || (data.dailyRequestLimit is int || data.dailyRequestLimit is number)) &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 120)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAuditLog(data) {
      return data.adminId is string && data.adminId == request.auth.uid &&
             data.action is string && data.action.size() > 0 && data.action.size() <= 100 &&
             data.details is string && data.details.size() <= 5000 &&
             data.timestamp is timestamp && data.timestamp <= request.time;
    }

    // Collection: Users
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       (!('role' in incoming()) || incoming().role == 'user' || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'aiRequestsCount', 'updatedAt']));
      allow delete: if isAdmin();

      // Subcollection: Chats
      match /chats/{chatId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId &&
                         isValidId(chatId) &&
                         isValidChatSession(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId &&
                         isValidId(chatId) &&
                         isValidChatSession(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'lastMessage', 'messageCount', 'updatedAt']);
        allow delete: if isSignedIn() && request.auth.uid == userId;

        // Subcollection: Messages
        match /messages/{messageId} {
          allow get, list: if isSignedIn() && request.auth.uid == userId;
          allow create: if isSignedIn() && request.auth.uid == userId &&
                           isValidId(messageId) &&
                           isValidChatMessage(incoming());
          allow update: if false; // Messages are immutable
          allow delete: if isSignedIn() && request.auth.uid == userId;
        }
      }

      // Subcollection: Math Solutions
      match /math_solutions/{solutionId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId &&
                         isValidId(solutionId) &&
                         isValidMathSolution(incoming());
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Subcollection: AI Creations
      match /creations/{creationId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId &&
                         isValidId(creationId) &&
                         isValidAiCreation(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId &&
                         isValidId(creationId) &&
                         isValidAiCreation(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'mediaUrl']);
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Collection: Global App Configuration
    match /config/app_config {
      // Any signed in user can read app configuration in real time
      allow get: if isSignedIn();
      // Only authorized admins can update app configuration
      allow create, update: if isAdmin() && isValidAppConfig(incoming());
      allow delete: if false;
    }

    // Collection: Admins
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Collection: Audit Logs
    match /audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false; // Audit logs are immutable
    }
  }
}
