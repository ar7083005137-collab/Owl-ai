{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with account metadata and usage stats",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "aiRequestsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "email", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Conversation thread with the AI assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "lastMessage": { "type": "string" },
        "messageCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A single message in a chat thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "userId", "role", "content", "createdAt"]
    },
    "MathSolution": {
      "title": "MathSolution",
      "description": "Step-by-step math solution",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "query": { "type": "string" },
        "hasImage": { "type": "boolean" },
        "steps": { "type": "array" },
        "finalAnswer": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "query", "steps", "finalAnswer", "createdAt"]
    },
    "AiCreation": {
      "title": "AiCreation",
      "description": "Generated AI image or video creation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "video"] },
        "prompt": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "aspectRatio": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "pending", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "prompt", "mediaUrl", "status", "createdAt"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Global dynamic AI and application configuration",
      "type": "object",
      "properties": {
        "version": { "type": "number" },
        "maintenanceMode": { "type": "boolean" },
        "activeChatProvider": { "type": "string" },
        "chatModel": { "type": "string" },
        "activeImageProvider": { "type": "string" },
        "imageModel": { "type": "string" },
        "activeVideoProvider": { "type": "string" },
        "videoModel": { "type": "string" },
        "chatEnabled": { "type": "boolean" },
        "mathEnabled": { "type": "boolean" },
        "photoMathEnabled": { "type": "boolean" },
        "imageGenEnabled": { "type": "boolean" },
        "videoGenEnabled": { "type": "boolean" },
        "dailyRequestLimit": { "type": "number" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["version", "maintenanceMode", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "addedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Admin action audit log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminId": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["adminId", "action", "details", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "ChatSession",
      "description": "User conversation sessions"
    },
    "/users/{userId}/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Individual messages in a chat session"
    },
    "/users/{userId}/math_solutions/{solutionId}": {
      "schema": "MathSolution",
      "description": "User math problem solver history"
    },
    "/users/{userId}/creations/{creationId}": {
      "schema": "AiCreation",
      "description": "User AI image and video creations"
    },
    "/config/app_config": {
      "schema": "AppConfig",
      "description": "Real-time global application configuration"
    },
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Authorized admin users registry"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Admin activity audit trails"
    }
  }
}
